{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.4.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "piechart",
      "name": "Pie chart",
      "version": "5.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": "5.0.0"
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": "5.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": "5.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "description": "An overview of tailscaled daemon metrics including inbound/outbound traffic by path, dropped packets by reason, health messages, and per-machine drilldown with DERP vs non-DERP traffic breakdown. The dashboards were generated using tailscale-mixin (https://github.com/adinhodovic/tailscale-exporter/tree/main/tailscale-mixin).",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "tailscale",
        "tailscaled",
        "tailscale-mixin"
      ],
      "targetBlank": true,
      "title": "Tailscale",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Summary",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "The number of Tailscale machines reporting metrics.",
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "graphMode": "area",
        "percentChangeColorMode": "standard",
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "count(\n  tailscaled_health_messages{\n    cluster=\"$cluster\",\n    job=~\"$job\"\n  }\n)\n",
          "instant": false
        }
      ],
      "title": "Tailscale Machines",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Advertised and approved routes across all selected Tailscale machines.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "percent"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  tailscaled_advertised_routes{\n    cluster=\"$cluster\",\n    job=~\"$job\"\n  }\n)\n",
          "instant": true,
          "legendFormat": "Advertised"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  tailscaled_approved_routes{\n    cluster=\"$cluster\",\n    job=~\"$job\"\n  }\n)\n",
          "instant": true,
          "legendFormat": "Approved"
        }
      ],
      "title": "Advertised / Approved Routes",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Distribution of inbound traffic paths over the last hour.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "options": {
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "percent"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  increase(\n    tailscaled_inbound_bytes_total{\n      cluster=\"$cluster\",\n      job=~\"$job\"\n    }[1h]\n  )\n) by (path)\n",
          "instant": true,
          "legendFormat": "{{ path }}"
        }
      ],
      "title": "Paths Distribution Inbound [1h]",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Distribution of outbound traffic paths over the last hour.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "options": {
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "percent"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  increase(\n    tailscaled_outbound_bytes_total{\n      cluster=\"$cluster\",\n      job=~\"$job\"\n    }[1h]\n  )\n) by (path)\n",
          "instant": true,
          "legendFormat": "{{ path }}"
        }
      ],
      "title": "Paths Distribution Outbound [1h]",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Total inbound vs outbound traffic distribution.",
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "options": {
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "percent"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  rate(\n    tailscaled_inbound_bytes_total{\n      cluster=\"$cluster\",\n      job=~\"$job\"\n    }[1h]\n  )\n)\n",
          "instant": true,
          "legendFormat": "Inbound"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  rate(\n    tailscaled_outbound_bytes_total{\n      cluster=\"$cluster\",\n      job=~\"$job\"\n    }[1h]\n  )\n)\n",
          "instant": true,
          "legendFormat": "Outbound"
        }
      ],
      "title": "Inbound vs Outbound Traffic [1h]",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Distribution of dropped packets by reason.",
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "options": {
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "values": [
            "percent"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  increase(\n    tailscaled_outbound_dropped_packets_total{\n      cluster=\"$cluster\",\n      job=~\"$job\"\n    }[1h]\n  )\n) by (reason)\n",
          "instant": true,
          "legendFormat": "{{ reason }}"
        }
      ],
      "title": "Dropped Packets by Reason [1h]",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Top 20 Tailscale machines by inbound traffic over the last hour.",
      "fieldConfig": {
        "defaults": {
          "links": [],
          "thresholds": {
            "steps": []
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "id": 8,
      "options": {
        "footer": {
          "enablePagination": true
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Inbound Traffic (Bps)"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(\n  20,\n  sum(\n    rate(\n      tailscaled_inbound_bytes_total{\n        cluster=\"$cluster\",\n        job=~\"$job\"\n      }[1h]\n    )\n  ) by (tailscale_machine)\n)\n",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Top 20 Machines by Inbound Traffic (1h)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            },
            "indexByName": {
              "Value": 1,
              "tailscale_machine": 0
            },
            "renameByName": {
              "Value": "Inbound Traffic (Bps)",
              "tailscale_machine": "Tailscale Machine"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Tailscale machines with unapproved routes (advertised minus approved > 0).",
      "fieldConfig": {
        "defaults": {
          "links": [],
          "thresholds": {
            "steps": []
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "id": 9,
      "options": {
        "footer": {
          "enablePagination": true
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Unapproved Routes"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  tailscaled_advertised_routes{\n    cluster=\"$cluster\",\n    job=~\"$job\"\n  }\n) by (tailscale_machine)\n-\nsum(\n  tailscaled_approved_routes{\n    cluster=\"$cluster\",\n    job=~\"$job\"\n  }\n) by (tailscale_machine)\n> 0\n",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Machines with Unapproved Routes",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            },
            "indexByName": {
              "Value": 1,
              "tailscale_machine": 0
            },
            "renameByName": {
              "Value": "Unapproved Routes",
              "tailscale_machine": "Tailscale Machine"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Tailscale machines with dropped packets in the last hour.",
      "fieldConfig": {
        "defaults": {
          "links": [],
          "thresholds": {
            "steps": []
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "id": 10,
      "options": {
        "footer": {
          "enablePagination": true
        },
        "sortBy": [
          {
            "desc": true,
            "displayName": "Dropped Packets"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(\n  increase(\n    tailscaled_outbound_dropped_packets_total{\n      cluster=\"$cluster\",\n      job=~\"$job\"\n    }[1h]\n  )\n) by (tailscale_machine)\n/\nsum(\n  increase(\n    tailscaled_outbound_packets_total{\n      cluster=\"$cluster\",\n      job=~\"$job\"\n    }[1h]\n  )\n) by (tailscale_machine)\n* 100\n> 0\n",
          "format": "table",
          "instant": true
        }
      ],
      "title": "Machines with Dropped Packets (1h)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true
            },
            "indexByName": {
              "Value": 1,
              "tailscale_machine": 0
            },
            "renameByName": {
              "Value": "Dropped Packets",
              "tailscale_machine": "Tailscale Machine"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 11,
      "title": "Network Summary",
      "type": "row"
    },
    {
