        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Health messages by type across all machines.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisSoftMin": 0,
            "fillOpacity": 100,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
